{
  "name": "@local/personal-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal DeepSeek Harness plugin: remote control from Telegram and room for more features.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "features/*.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  },
  "scripts": {
    "test": "node --test test/"
  }
}
