{
  "name": "@local/personal-hub",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Personal DeepSeek Harness plugin: remote control from Telegram, and a Git panel with diffs, pull requests, issues, AI-drafted change requests, per-Session worktrees, and merge cleanup.",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node scripts/build.mjs && node --test \"test/*.test.ts\"",
    "test:unit": "node --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
